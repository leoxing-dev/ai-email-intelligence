# Copy this file to .env. Never put credentials or tokens in this example file.
GMAIL_ASSISTANT_CREDENTIALS_PATH=credentials.json
GMAIL_ASSISTANT_TOKEN_PATH=token.json
GMAIL_ASSISTANT_QUERY=in:inbox is:unread
GMAIL_ASSISTANT_MAX_MESSAGES=100
GMAIL_ASSISTANT_DEFAULT_TIMEZONE=America/Los_Angeles
GMAIL_ASSISTANT_LOG_LEVEL=INFO

# Synthetic benchmark model evaluation only. Keep provider disabled for Gmail use.
GMAIL_ASSISTANT_MODEL_PROVIDER=disabled
GMAIL_ASSISTANT_MODEL=gpt-5.6-terra
GMAIL_ASSISTANT_MODEL_REASONING=medium
GMAIL_ASSISTANT_MODEL_SERVICE_TIER=default
GMAIL_ASSISTANT_MODEL_TIMEOUT_SECONDS=120
GMAIL_ASSISTANT_MODEL_MAX_WORKERS=4
OPENAI_API_KEY=
